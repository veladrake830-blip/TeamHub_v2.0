# Connection strings. `npm run db:init` fills these in for the private dev database.
DATABASE_URL=postgresql://teamhub:change-me@localhost:5432/teamhub
TEST_DATABASE_URL=postgresql://teamhub:change-me@localhost:5432/teamhub_test

# Long random value used to sign access tokens.
JWT_SECRET=change-me

# Address users open in a browser. Used to build password reset links.
PUBLIC_URL=http://localhost:5173

PORT=4000

# Address to listen on. Use 127.0.0.1 behind a reverse proxy on the same server.
# HOST=127.0.0.1

UPLOAD_DIR=uploads

# Set to true when users reach the site over HTTPS. This secures the refresh cookie
# and tells browsers to stay on HTTPS. Leave false on plain HTTP, or login will not work.
COOKIE_SECURE=false

# Number of reverse proxies in front of the app. 0 if it is reached directly.
TRUST_PROXY=0

# Used once by `npm run db:seed` to create the Admin. Remove after seeding.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@teamhub.local
ADMIN_PASSWORD=
